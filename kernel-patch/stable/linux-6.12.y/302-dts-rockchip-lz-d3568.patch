From b0ee0cb28eaa23c61141f910a30672b32318624f Mon Sep 17 00:00:00 2001
From: MaxCrazy1101 <35657483+MaxCrazy1101@users.noreply.github.com>
Date: Tue, 10 Feb 2026 19:39:32 +0800
Subject: [PATCH] arm64: dts: rockchip lz-d3568

---
 .../boot/dts/rockchip/rk3568-lz-d3568-v3.dts  | 39 +++++++++++++++++--
 .../boot/dts/rockchip/rk3568-lz-k3568.dts     | 33 +++++++++-------
 2 files changed, 55 insertions(+), 17 deletions(-)

diff --git a/arch/arm64/boot/dts/rockchip/rk3568-lz-d3568-v3.dts b/arch/arm64/boot/dts/rockchip/rk3568-lz-d3568-v3.dts
index 76492d32b2..4da14861ce 100644
--- a/arch/arm64/boot/dts/rockchip/rk3568-lz-d3568-v3.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3568-lz-d3568-v3.dts
@@ -34,6 +34,7 @@
 	pinctrl-0 = <&uart3m1_xfer>;
 };
 
+/* LCD屏幕 */
 &uart4 {
 	status = "okay";
 	pinctrl-names = "default";
@@ -47,19 +48,19 @@
 };
 
 &uart7 {
-	status = "okay";
+	status = "disabled";
 	pinctrl-names = "default";
 	pinctrl-0 = <&uart7m1_xfer>;
 };
 
 &uart8 {
-	status = "okay";
+	status = "disabled";
 	pinctrl-names = "default";
 	pinctrl-0 = <&uart8m1_xfer>;
 };
 
 &uart9 {
-	status = "okay";
+	status = "disabled";
 	pinctrl-names = "default";
 	pinctrl-0 = <&uart9m1_xfer>;
 };
@@ -75,3 +76,35 @@
 	pinctrl-names = "default";
 	pinctrl-0 = <&can2m0_pins>;
 };
+
+
+// Conflict Analysis:
+// uart0 (phandle 0x48) uses GPIO0_C0 (Pin 16) as Function 3.
+// pwm1 (phandle 0x4a) uses GPIO0_C0 (Pin 16) as Function 1 (pwm1m0-pins).
+&pwm1 {
+	status = "disabled";
+};
+
+// Conflict Analysis:
+// uart0 (phandle 0x48) uses GPIO0_C1 (Pin 17) as Function 3.
+// pwm2 (phandle 0x4b) uses GPIO0_C1 (Pin 17) as Function 1 (pwm2m0-pins).
+&pwm2 {
+	status = "disabled";
+};
+
+&usb_host0_xhci {
+	status = "disabled";
+};
+
+&usb_host1_xhci {
+	status = "disabled";
+};
+
+&sata0 {
+	status = "disabled";
+};
+
+// HW3.0 no sata1 but usb3.0
+&sata1 {
+	status = "disabled";
+};
diff --git a/arch/arm64/boot/dts/rockchip/rk3568-lz-k3568.dts b/arch/arm64/boot/dts/rockchip/rk3568-lz-k3568.dts
index cd57b0129b..ed394d665d 100644
--- a/arch/arm64/boot/dts/rockchip/rk3568-lz-k3568.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3568-lz-k3568.dts
@@ -1,7 +1,6 @@
 // SPDX-License-Identifier: (GPL-2.0+ OR MIT)
 /*
  * Copyright (c) 2021 Rockchip Electronics Co., Ltd.
- *
  */
 
 /dts-v1/;
@@ -13,7 +12,7 @@
 
 / {
 	model = "LZ-K3568";
-	compatible = "rockchip,rk3568-evb1-v10", "rockchip,rk3568";
+	compatible = "lz,k3568", "rockchip,rk3568";
 
 	aliases {
 		ethernet0 = &gmac0;
@@ -39,7 +38,6 @@
 		};
 	};
 
-
 	gmac0_xpcsclk: xpcs-gmac0-clock {
 		compatible = "fixed-clock";
 		clock-frequency = <125000000>;
@@ -206,8 +204,10 @@
 	assigned-clock-rates = <0>, <125000000>;
 
 	clock_in_out = "output";
-	tx_delay = <0x30>;    /* 0x4e */
-	rx_delay = <0x10>;    /* 0x0b */
+
+	//tx_delay = <0>;    /* 0x4e */
+	//rx_delay = <0>;    /* 0x0b */
+	//rockchip,sgmii-rx-clk-invert;
 
 	phy-handle = <&sgmii_phy>;
 	phy-mode = "sgmii";
@@ -229,9 +229,9 @@
 
 /* RGMII (Port 1, eth0) */
 &gmac1 {
-	assigned-clocks = <&cru SCLK_GMAC1>, <&cru SCLK_GMAC1_RX_TX>;
-	assigned-clock-parents = <&cru 391>;
-	assigned-clock-rates = <0>, <125000000>;
+	assigned-clocks = <&cru SCLK_GMAC1_RX_TX>, <&cru SCLK_GMAC1>;
+	assigned-clock-parents = <&cru SCLK_GMAC1_RGMII_SPEED>, <&cru CLK_MAC1_2TOP>;
+	assigned-clock-rates = <125000000>, <0>;
 
 	clock_in_out = "output";
 	phy-handle = <&rgmii_phy>;
@@ -284,17 +284,19 @@
 &i2c0 {
 	status = "okay";
 
-	vdd_cpu: regulator@1c {
-		compatible = "tcs,tcs4525";
-		reg = <0x1c>;
+	vdd_cpu: regulator@41 {
+		compatible = "rockchip,rk860", "silergy,syr827";
+		reg = <0x41>;
 		fcs,suspend-voltage-selector = <1>;
 		regulator-name = "vdd_cpu";
 		regulator-always-on;
 		regulator-boot-on;
-		regulator-min-microvolt = <800000>;
-		regulator-max-microvolt = <1150000>;
+		regulator-min-microvolt = <712500>;
+		regulator-max-microvolt = <1390000>;
+		regulator-init-microvolt = <900000>;
 		regulator-ramp-delay = <2300>;
 		vin-supply = <&vcc5v0_sys>;
+		regulator-compatible = "rk860";
 
 		regulator-state-mem {
 			regulator-off-in-suspend;
@@ -309,7 +311,7 @@
 		assigned-clocks = <&cru I2S1_MCLKOUT_TX>;
 		assigned-clock-parents = <&cru CLK_I2S1_8CH_TX>;
 		#clock-cells = <1>;
-		clock-output-names = "rk808-clkout1", "rk808-clkout2";
+		clock-output-names = "rk809-clkout1", "rk809-clkout2";
 		clocks = <&cru I2S1_MCLKOUT_TX>;
 		pinctrl-names = "default";
 		pinctrl-0 = <&pmic_int>, <&i2s1m0_mclk>;
@@ -344,6 +346,7 @@
 			vdd_gpu: DCDC_REG2 {
 				regulator-name = "vdd_gpu";
 				regulator-always-on;
+				regulator-boot-on;
 				regulator-initial-mode = <0x2>;
 				regulator-min-microvolt = <500000>;
 				regulator-max-microvolt = <1350000>;
@@ -427,6 +430,7 @@
 			vccio_acodec: LDO_REG4 {
 				regulator-name = "vccio_acodec";
 				regulator-always-on;
+				regulator-boot-on;
 				regulator-min-microvolt = <3300000>;
 				regulator-max-microvolt = <3300000>;
 
@@ -547,6 +551,7 @@
 		reg = <0x0>;
 		motorcomm,clk-out-frequency-hz = <125000000>;
 		motorcomm,keep-pll-enabled;
+		motorcomm,auto-sleep-disabled;
 
 		eee-broken-1000t;
 		eee-broken-100tx;
